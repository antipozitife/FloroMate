{
    "name": "floromate",
    "version": "2.0.2",
    "description": "Интерактивная React-платформа для ухода за растениями и проектирования сада",
    "main": "./src/index.tsx",
    "scripts": {
        "dev": "DEMO_MODE=true webpack serve --mode development",
        "dev:demo": "DEMO_MODE=true webpack serve --mode development",
        "dev:api": "DEMO_MODE=false webpack serve --mode development",
        "start": "DEMO_MODE=true webpack serve --mode development --open",
        "build": "npm run clean && webpack --mode development",
        "build:prod": "npm run clean && DEMO_MODE=true webpack --mode production",
        "build:demo": "npm run clean && DEMO_MODE=true webpack --mode production",
        "build:api": "npm run clean && DEMO_MODE=false webpack --mode production",
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "typecheck": "tsc --noEmit",
        "test": "npm run typecheck",
        "check": "npm run typecheck && npm run build:prod"
    },
    "keywords": [
        "react",
        "typescript",
        "redux-toolkit",
        "threejs",
        "frontend",
        "portfolio"
    ],
    "license": "ISC",
    "type": "commonjs",
    "dependencies": {
        "@gsap/react": "^2.1.2",
        "@reduxjs/toolkit": "^2.11.0",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "axios": "^1.13.2",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "^4.21.2",
        "form-data": "^4.0.4",
        "gsap": "^3.14.2",
        "html2canvas": "^1.4.1",
        "http-proxy-agent": "^7.0.2",
        "https-proxy-agent": "^7.0.6",
        "jspdf": "^3.0.4",
        "mime-types": "^3.0.1",
        "motion": "^12.23.26",
        "multer": "^2.0.2",
        "node-sms-ru": "^0.3.0",
        "pg": "^8.16.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-redux": "^9.2.0",
        "react-router-dom": "^6.20.1",
        "three": "^0.182.0",
        "uuid": "^13.0.0"
    },
    "devDependencies": {
        "@babel/core": "^7.28.5",
        "@babel/preset-env": "^7.28.5",
        "@types/node": "^25.0.1",
        "@types/three": "^0.182.0",
        "babel-loader": "^10.0.0",
        "copy-webpack-plugin": "^13.0.1",
        "crypto-browserify": "^3.12.1",
        "css-loader": "^7.1.4",
        "html-webpack-plugin": "^5.6.8",
        "os-browserify": "^0.3.0",
        "path-browserify": "^1.0.1",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.6.2",
        "webpack": "^5.109.0",
        "webpack-cli": "^6.0.1",
        "webpack-dev-server": "^5.2.6"
    }
}
